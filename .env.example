# GigaChat (физлица, freemium)
LLM_PROVIDER=gigachat
LLM_AUTH_KEY=
LLM_MODEL=GigaChat
LLM_SCOPE=GIGACHAT_API_PERS
GIGACHAT_EMBEDDINGS_API_BASE=https://api.giga.chat/v1
# Для текущей legacy-модели GigaChat; новый host можно подставить после миграции.
GIGACHAT_CHAT_API_BASE=https://gigachat.devices.sberbank.ru/api/v1

# Либо любой OpenAI-совместимый провайдер:
# LLM_PROVIDER=openai
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
